---
import Layout from "@/layouts/Layout.astro";

// I tuoi componenti React
import Hero from "@/components/Hero";
import BentoShowcase from "@/components/BentoShowcase";
import TechStack from "@/components/TechStack";
import TrustSection from "@/components/TrustSection";
import Projects from "@/components/Projects";
import DemoProjectsGrid from "@/components/DemoProjectsGrid";
import Packages from "@/components/Packages";
import { demoProducts } from "@/data/projects";
---

<Layout>
  <div class="min-h-screen bg-[#09090b] text-white">
    {/* 1. HERO */}
    <Hero client:load />

    {/* 2. BENTO SHOWCASE */}
    <BentoShowcase client:visible />

    {/* 3. STACK TECNOLOGICO */}
    <TechStack client:visible />

    {/* 4. RISULTATI & AFFIDABILITÀ */}
    <section class="py-12 md:py-16 bg-[#0a0a0c] border-t border-zinc-900/80">
      <TrustSection client:visible />
    </section>

    {/* 5. PORTFOLIO PROGETTI */}
    <section id="progetti" class="py-16 md:py-24 bg-[#09090b] text-white border-t border-zinc-900/80 w-full overflow-hidden">
      <Projects client:visible />
    </section>

    {/* 6. DEMO LIVE TEMPLATE (SEZIONE LIGHT A CONTRASTO) */}
    <section id="demo" class="py-16 md:py-24 bg-zinc-100 text-zinc-900 border-y border-zinc-300 overflow-visible">
      <DemoProjectsGrid client:visible products={demoProducts} />
    </section>

    {/* 7. PACCHETTI E PIANI */}
    <section id="pacchetti" class="py-16 md:py-24 bg-[#09090b] text-white border-t border-zinc-900/80">
      <div class="max-w-7xl mx-auto px-6">
        <Packages client:visible />
      </div>
    </section>
  </div>
</Layout>
