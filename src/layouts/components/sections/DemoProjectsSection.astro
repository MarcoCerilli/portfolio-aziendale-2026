---
import DemoProjectsGrid from "@/react/DemoProjectsGrid";
import { projectsList } from "@/data/projects";
import type { DemoProduct } from "@/types/vercel";

const demoProducts: DemoProduct[] = projectsList
  .filter(p => p.status === "demo")
  .map((p, idx) => ({
    id: idx.toString(),
    name: p.title,
    url: p.link,
    category: p.category,
    price: null,
    image: p.image,
    features: p.tags
  }));
---
<section class="py-12 md:py-16 bg-white dark:bg-slate-950 border-b border-slate-100 dark:border-slate-800 w-full overflow-hidden">
  <DemoProjectsGrid client:load products={demoProducts} />
</section>
