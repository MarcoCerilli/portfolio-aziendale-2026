---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label="Cambia tema chiaro o scuro"
  class:list={[
    "theme-toggle-btn relative inline-flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:bg-slate-200 dark:hover:bg-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all duration-200 shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 cursor-pointer active:scale-95",
    className,
  ]}
>
  {/* Sun Icon (shown in dark mode) */}
  <svg
    class="sun-icon hidden h-5 w-5 dark:block text-amber-400 transition-transform duration-300 pointer-events-none"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v1m0 16v1m9-9h-1M4 9H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    />
  </svg>

  {/* Moon Icon (shown in light mode) */}
  <svg
    class="moon-icon block h-5 w-5 dark:hidden text-slate-700 transition-transform duration-300 pointer-events-none"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    />
  </svg>
</button>

<script is:inline>
  function initThemeButtons() {
    document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
      btn.onclick = () => {
        const isDark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("theme", isDark ? "dark" : "light");
        } catch (e) {}
        window.dispatchEvent(new CustomEvent("theme-change", { detail: { isDark } }));
      };
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initThemeButtons);
  } else {
    initThemeButtons();
  }
  document.addEventListener("astro:page-load", initThemeButtons);
  document.addEventListener("astro:after-swap", initThemeButtons);
</script>
