---
import Icons from "@/helpers/Icons.astro";
---

<button
  type="button"
  class="back-to-top-button border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-100 hover:border-indigo-600 hover:bg-indigo-600 dark:hover:bg-indigo-600 pointer-events-none fixed right-5 bottom-28 z-50 flex size-11 items-center justify-center rounded-2xl border bg-white/90 dark:bg-slate-800/90 backdrop-blur-md opacity-0 shadow-xl transition-all duration-300 hover:text-white dark:hover:text-white hover:scale-110 active:scale-95 [&.scroll-down]:pointer-events-auto [&.scroll-down]:opacity-100 cursor-pointer"
  data-back-to-top
  data-cursor-ignore
  aria-label="Torna in alto">
  <Icons icon="ArrowUp" class="size-5" />
</button>

<script>
  // @ts-nocheck
  const isInIframe = () => {
    try {
      return window.self !== window.top;
    } catch {
      return true;
    }
  };

  if (!isInIframe()) {
    const backToTopButton = document.querySelector("[data-back-to-top]");

    if (backToTopButton) {
      const toggleBackToTop = () => {
        backToTopButton.classList.toggle("scroll-down", window.scrollY >= 500);
      };

      backToTopButton.addEventListener("click", () => {
        if (window.__techloLenis) {
          window.__techloLenis.scrollTo(0);
          return;
        }

        window.scrollTo({
          top: 0,
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
            .matches
            ? "auto"
            : "smooth",
        });
      });

      toggleBackToTop();
      window.addEventListener("scroll", toggleBackToTop, { passive: true });
    }
  }
</script>
