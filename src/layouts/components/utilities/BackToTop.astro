---
import Icons from "@/helpers/Icons.astro";
---

<button
  type="button"
  class="back-to-top-button pointer-events-none fixed right-5 md:right-6 bottom-[76px] md:bottom-[84px] z-50 flex size-12 items-center justify-center rounded-full border border-zinc-300 bg-white text-zinc-900 shadow-2xl opacity-0 transition-all duration-200 hover:bg-zinc-100 hover:text-black hover:scale-105 active:scale-95 [&.scroll-down]:pointer-events-auto [&.scroll-down]:opacity-100 cursor-pointer"
  data-back-to-top
  data-cursor-ignore
  aria-label="Torna in alto">
  <Icons icon="ArrowUp" class="size-5 text-zinc-900" />
</button>

<script>
  // @ts-nocheck
  const isInIframe = () => {
    try {
      return window.self !== window.top;
    } catch {
      return true;
    }
  };

  if (!isInIframe()) {
    const backToTopButton = document.querySelector("[data-back-to-top]");

    if (backToTopButton) {
      const toggleBackToTop = () => {
        backToTopButton.classList.toggle("scroll-down", window.scrollY >= 500);
      };

      backToTopButton.addEventListener("click", () => {
        if (window.__techloLenis) {
          window.__techloLenis.scrollTo(0);
          return;
        }

        window.scrollTo({
          top: 0,
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
            .matches
            ? "auto"
            : "smooth",
        });
      });

      toggleBackToTop();
      window.addEventListener("scroll", toggleBackToTop, { passive: true });
    }
  }
</script>
